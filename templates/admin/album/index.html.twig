{% extends 'admin.html.twig' %}

{% block admin %}
    <div class="d-flex justify-content-between align-items-center">
        <h1>Albums</h1>
        <a href="{{ path('admin_album_add') }}" class="btn btn-primary">Ajouter</a>
    </div>
    <table class="table">
        <thead>
        <tr>
            <th>Nom</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for album in albums %}
            <tr>
                <td>{{ album.name }}</td>
                <td>
                    <a href="{{ path('admin_album_update', {album: album.id}) }}" class="btn btn-warning">Modifier</a>
                    <form action="{{ path('admin_album_delete', {album: album.id}) }}" method="post" class="d-inline"
                          onsubmit="return confirm('Supprimer cet album et tous ses médias ? Cette action est irréversible.');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_album') }}">
                        <button type="submit" class="btn btn-danger">Supprimer l'album et ses médias</button>
                    </form>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}