{% extends 'base.html.twig' %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-3 col-lg-2 d-none d-md-block bg-dark sidebar min-vh-100 p-4">
                <div class="position-sticky">
                    <h1 class="text-white">Admin</h1>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('admin_media_index') }}">
                                Medias
                            </a>
                        </li>
                        {% if is_granted('ROLE_ADMIN') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('admin_album_index') }}">
                                    Albums
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('admin_guest') }}">
                                    Invités
                                </a>
                            </li>
                        {% endif %}
                        <li class="nav-item">
                            <form action="{{ path('logout') }}" method="post">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                                <button class="nav-link" type="submit">Déconnexion</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </nav>
            <main class="col-md-9 ms-sm-auto col-lg-10 p-4">
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type == 'error' ? 'danger' : type }}" role="alert">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                {% block admin %}{% endblock %}
            </main>
        </div>
    </div>
{% endblock %}