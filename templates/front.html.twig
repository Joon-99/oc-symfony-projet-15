{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&display=swap" rel="stylesheet">
    <link href="{{ asset('style.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
    <header>
        <nav>
            <div class="container">
                <div class="d-flex justify-content-between align-items-center py-4">
                    <a href="{{ path('home') }}">
                        <img src="{{ 'images/logo.png' | imagine_filter('compressed') }}" alt="Ina Zaoui">
                    </a>
                    <ul class="nav">
                        {% if is_granted('ROLE_USER') %}
                            {% set mediaLinkTxt = is_granted('ROLE_ADMIN') ? 'Admin' : 'Mes médias' %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('media_index') }}">{{ mediaLinkTxt }}</a>
                            </li>
                        {% endif %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('guests') }}">Invités</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('portfolio') }}">Portfolio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('about') }}">Qui suis-je ?</a>
                        </li>
                        {% if is_granted('ROLE_USER') %}
                            <li class="nav-item">
                                <form action="{{ path('logout') }}" method="post">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                                    <button class="nav-link" type="submit">Déconnexion</button>
                                </form>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('login') }}">Connexion</a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main>
        <div class="container py-4">
            {% block front %}{% endblock %}
        </div>
    </main>
    <footer class="py-4 text-center">
        Ina Zaoui copyright 2024©
    </footer>
{% endblock %}